{
  "expo": {
    "name": "Keyra",
    "slug": "airvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kuzey.airvault"
    },
    "android": {
      "package": "com.kuzey.airvault",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Keyra'nın QR kodları tarayabilmesi için kamera izni gerekiyor."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b26ffa68-22eb-4791-9deb-4125638393e5"
      }
    },
    "owner": "kayradivriktir"
  }
}
